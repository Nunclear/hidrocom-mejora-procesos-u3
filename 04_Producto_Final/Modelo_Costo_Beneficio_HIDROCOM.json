  "formulas": {
    "revisar_esperado_por_lote": "max(0, revisar - casos_alcanzables * eficacia)",
    "tasa_revisar_esperada": "revisar_esperado_por_lote / renglones",
    "horas_antes": "revisar * minutos_por_revision / 60",
    "horas_despues": "revisar_esperado_por_lote * minutos_por_revision / 60",
    "pen_antes_por_lote": "horas_antes * pen_por_hora",
    "pen_despues_por_lote": "horas_despues * pen_por_hora",
    "costo_inicial_pen": "horas_implementacion * pen_por_hora",
    "beneficio_bruto_anual_pen": "(pen_antes_por_lote - pen_despues_por_lote) * lotes_por_mes * 12 * proporcion_aprovechada",
    "beneficio_neto_anual_pen": "beneficio_bruto_anual_pen - costo_inicial_pen - (costo_recurrente_anual_pen si está informado)",
    "van_horizonte_un_anio_pen": "-costo_inicial_pen + (beneficio_bruto_anual_pen - costo_recurrente_informado) / (1 + tasa_descuento_ilustrativa)",
    "revisar_evitados_equilibrio_por_mes": "(costo_inicial_pen + costo_recurrente_informado) / (12 * (minutos_por_revision / 60) * pen_por_hora * proporcion_aprovechada)",
    "revisar_inicial_equilibrio_por_mes": "revisar_evitados_equilibrio_por_mes / (min(revisar, casos_alcanzables * eficacia) / revisar)",
    "costo_recurrente_informado": "importe de costo recurrente cuando es numérico. Si no existe estimación, se excluye del escenario calculado."
